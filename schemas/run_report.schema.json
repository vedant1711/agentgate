{
  "$defs": {
    "BudgetSpec": {
      "additionalProperties": false,
      "description": "Hard caps enforced by the runner (A3.6). Zero means unlimited.",
      "properties": {
        "max_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Max Cost Usd",
          "type": "number"
        },
        "max_requests": {
          "default": 0,
          "minimum": 0,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_wall_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Max Wall S",
          "type": "number"
        }
      },
      "title": "BudgetSpec",
      "type": "object"
    },
    "Estimate": {
      "additionalProperties": false,
      "description": "A point estimate that cannot exist without its uncertainty.\n\n``se`` and the interval may be ``None`` only for degenerate samples (n < 2), in which case\n``method`` records why.",
      "properties": {
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "ci_level": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Ci Level",
          "type": "number"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "method": {
          "description": "Which interval procedure produced this, e.g. 'wilson'.",
          "title": "Method",
          "type": "string"
        },
        "n": {
          "description": "Independent units (tasks, or clusters when clustered).",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "se": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Se"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "method",
        "n"
      ],
      "title": "Estimate",
      "type": "object"
    },
    "MetricFamily": {
      "description": "Metric families from Part B of the specification.",
      "enum": [
        "outcome",
        "trajectory",
        "rag",
        "safety",
        "efficiency",
        "reliability"
      ],
      "title": "MetricFamily",
      "type": "string"
    },
    "MetricSummary": {
      "additionalProperties": false,
      "description": "Single-run inference for one metric over one suite (C1).",
      "properties": {
        "clustered": {
          "anyOf": [
            {
              "$ref": "#/$defs/Estimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cluster-robust version; present only when clusters exist."
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ],
          "title": "Direction",
          "type": "string"
        },
        "dtype": {
          "enum": [
            "binary",
            "proportion",
            "continuous",
            "count"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "estimate": {
          "$ref": "#/$defs/Estimate"
        },
        "family": {
          "$ref": "#/$defs/MetricFamily"
        },
        "judge_backed": {
          "default": false,
          "title": "Judge Backed",
          "type": "boolean"
        },
        "k": {
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "n_scored_samples": {
          "minimum": 0,
          "title": "N Scored Samples",
          "type": "integer"
        },
        "n_skipped": {
          "default": 0,
          "minimum": 0,
          "title": "N Skipped",
          "type": "integer"
        },
        "n_tasks": {
          "minimum": 0,
          "title": "N Tasks",
          "type": "integer"
        },
        "per_task": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Task-level means over K reps (the analysis unit).",
          "title": "Per Task",
          "type": "object"
        },
        "se_inflation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clustered_se / naive_se \u2014 the number E3 says can exceed 3.",
          "title": "Se Inflation"
        },
        "variance": {
          "anyOf": [
            {
              "$ref": "#/$defs/VarianceDecomposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "metric",
        "family",
        "dtype",
        "direction",
        "n_tasks",
        "n_scored_samples",
        "k",
        "estimate"
      ],
      "title": "MetricSummary",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "description": "A pinned model used in a role. Version pinning is what makes judge drift detectable.",
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "role": {
          "enum": [
            "agent",
            "judge",
            "embedding"
          ],
          "title": "Role",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "role",
        "model_id"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "PassKPoint": {
      "additionalProperties": false,
      "description": "pass@k and pass^k at one value of k (B6, E2).",
      "properties": {
        "k": {
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "pass_at_k": {
          "$ref": "#/$defs/Estimate"
        },
        "pass_hat_k": {
          "$ref": "#/$defs/Estimate"
        }
      },
      "required": [
        "k",
        "pass_at_k",
        "pass_hat_k"
      ],
      "title": "PassKPoint",
      "type": "object"
    },
    "ProviderMode": {
      "description": "Execution mode for the provider layer (A5).\n\n``live``   \u2014 call the provider, no cache writes.\n``cache``  \u2014 call the provider, write through to the SQLite cache.\n``replay`` \u2014 cache only; a miss is a hard error. CI default.\n``mock``   \u2014 canned deterministic fixtures; used by unit tests, never touches the network.",
      "enum": [
        "live",
        "cache",
        "replay",
        "mock"
      ],
      "title": "ProviderMode",
      "type": "string"
    },
    "ReliabilityReport": {
      "additionalProperties": false,
      "description": "The reliability family for one binary base metric.",
      "properties": {
        "base_metric": {
          "title": "Base Metric",
          "type": "string"
        },
        "curve": {
          "items": {
            "$ref": "#/$defs/PassKPoint"
          },
          "title": "Curve",
          "type": "array"
        },
        "flake_rate": {
          "$ref": "#/$defs/Estimate"
        },
        "flakiest_tasks": {
          "items": {
            "$ref": "#/$defs/TaskFlake"
          },
          "title": "Flakiest Tasks",
          "type": "array"
        },
        "k_max": {
          "minimum": 1,
          "title": "K Max",
          "type": "integer"
        },
        "score_variance": {
          "default": 0.0,
          "title": "Score Variance",
          "type": "number"
        }
      },
      "required": [
        "base_metric",
        "k_max",
        "flake_rate"
      ],
      "title": "ReliabilityReport",
      "type": "object"
    },
    "RunManifest": {
      "additionalProperties": false,
      "description": "Everything needed to reproduce a run byte-for-byte (A3.4).\n\n:attr:`config_hash` deliberately excludes wall-clock and host details so that two runs on\ndifferent machines with the same inputs and the same replay cache hash identically.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "agentgate_version": {
          "title": "Agentgate Version",
          "type": "string"
        },
        "base_seed": {
          "title": "Base Seed",
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/BudgetSpec"
        },
        "config_hash": {
          "description": "Deterministic hash of :meth:`reproducibility_key`.",
          "readOnly": true,
          "title": "Config Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "faults": {
          "items": {
            "type": "string"
          },
          "title": "Faults",
          "type": "array"
        },
        "git_dirty": {
          "default": false,
          "title": "Git Dirty",
          "type": "boolean"
        },
        "git_sha": {
          "default": "unknown",
          "title": "Git Sha",
          "type": "string"
        },
        "host": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Platform info. Excluded from config_hash by design.",
          "title": "Host",
          "type": "object"
        },
        "k": {
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "library_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Library Versions",
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/ProviderMode"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelRef"
          },
          "title": "Models",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "prompt_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Hashes",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "suite": {
          "$ref": "#/$defs/SuiteRef"
        },
        "system": {
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "agentgate_version",
        "suite",
        "system",
        "agent",
        "k",
        "base_seed",
        "mode",
        "config_hash"
      ],
      "title": "RunManifest",
      "type": "object"
    },
    "SuiteRef": {
      "additionalProperties": false,
      "description": "Immutable pointer to the exact suite content a run consumed.",
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "n_clusters": {
          "title": "N Clusters",
          "type": "integer"
        },
        "n_tasks": {
          "title": "N Tasks",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "content_hash",
        "n_tasks",
        "n_clusters"
      ],
      "title": "SuiteRef",
      "type": "object"
    },
    "TaskFlake": {
      "additionalProperties": false,
      "description": "A task that succeeded only sometimes \u2014 the CI-killing behaviour (B6).",
      "properties": {
        "k": {
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "successes": {
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "successes",
        "k"
      ],
      "title": "TaskFlake",
      "type": "object"
    },
    "VarianceDecomposition": {
      "additionalProperties": false,
      "description": "Between-task vs within-task variance split (C1.5).\n\nThe intraclass correlation answers the free-tier budgeting question directly: high ICC\nmeans buy more tasks, low ICC means buy more repetitions.",
      "properties": {
        "between_task_var": {
          "minimum": 0.0,
          "title": "Between Task Var",
          "type": "number"
        },
        "icc": {
          "description": "Between / (between + within); may be clipped to 0.",
          "title": "Icc",
          "type": "number"
        },
        "k": {
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "n_tasks": {
          "minimum": 0,
          "title": "N Tasks",
          "type": "integer"
        },
        "recommendation": {
          "default": "",
          "title": "Recommendation",
          "type": "string"
        },
        "within_task_var": {
          "minimum": 0.0,
          "title": "Within Task Var",
          "type": "number"
        }
      },
      "required": [
        "between_task_var",
        "within_task_var",
        "icc",
        "n_tasks",
        "k"
      ],
      "title": "VarianceDecomposition",
      "type": "object"
    }
  },
  "$id": "https://agentgate.dev/schemas/run_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Full single-run analysis: every metric with uncertainty, plus reliability.",
  "properties": {
    "manifest": {
      "$ref": "#/$defs/RunManifest"
    },
    "reliability": {
      "items": {
        "$ref": "#/$defs/ReliabilityReport"
      },
      "title": "Reliability",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "summaries": {
      "items": {
        "$ref": "#/$defs/MetricSummary"
      },
      "title": "Summaries",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "manifest"
  ],
  "title": "RunReport",
  "type": "object"
}
